<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111239">

    <WebView
        android:id="@+id/webViewMonitorik"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <!-- Ya no se usa como texto de error clickeable; se deja oculta y sin uso visual -->
    <TextView
        android:id="@+id/errorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@android:color/white"
        android:padding="20dp"
        android:textAlignment="center"
        android:visibility="gone"
        android:text="" />

    <ImageView
        android:id="@+id/imgSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_monitorik" />

    <!-- Overlay de reconexión: reemplaza cualquier error nativo del WebView -->
    <!-- Overlay de reconexión: fondo semitransparente oscuro para que el texto sea visible -->
    <FrameLayout
        android:id="@+id/reconnectingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp">

        <!-- Contenido centrado (icono y textos) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#FFFFFF"
                android:contentDescription="Sin conexión" />

            <TextView
                android:id="@+id/reconnectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reconectando"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/reconnectMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fallo por la conexión a Internet, se reintentará en 3 segundos."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:maxWidth="280dp"
                    android:ellipsize="end"
                    android:maxLines="2" />

            </LinearLayout>

        </LinearLayout>

                <!-- Botón de reintento manual en la esquina inferior derecha -->
        <Button
            android:id="@+id/btnManualRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reintentar"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:visibility="visible"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_retry"
            android:textColor="#FFFFFF" />

    </FrameLayout>

</FrameLayout>
