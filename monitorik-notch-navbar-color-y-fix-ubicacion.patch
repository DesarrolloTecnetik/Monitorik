+    // en contenido que llega desde JS, aunque sea nuestro propio sitio).
+    private inner class ColorBridge {
+        @JavascriptInterface
+        fun onColorsDetected(topColorHex: String?, bottomColorHex: String?) {
+            runOnUiThread {
