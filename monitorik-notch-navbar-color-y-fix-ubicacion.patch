+    // ============================================================
+    // --- Color dinámico de notchBar/navBar según lo que se ve en pantalla ---
+    // ============================================================
+    //
+    // La app es un WebView apuntando a un sitio externo (tecnserv.com), así
+    // que no controlamos su HTML/CSS desde acá. En vez de depender de que la
+    // web nos avise su color "a mano", detectamos nosotros mismos qué color
+    // de fondo hay justo detrás de la franja del notch y de la franja de
+    // botones: tomamos el elemento que hay en ese punto de la pantalla
+    // (elementFromPoint) y subimos por sus ancestros hasta encontrar el
+    // primer background-color opaco. Así funciona para cualquier pantalla de
+    // la web sin tener que tocar su código.
+
+    private val colorDetectorScript = """
+        (function() {
+          if (window.__monitorikColorWatcherInstalled) return;
+          window.__monitorikColorWatcherInstalled = true;
+
+          function toHex(colorStr) {
+            if (!colorStr) return null;
+            var m = colorStr.match(/rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)/i);
+            if (!m) return null;
+            var r = parseInt(m[1], 10), g = parseInt(m[2], 10), b = parseInt(m[3], 10);
+            var a = m[4] !== undefined ? parseFloat(m[4]) : 1;
+            if (a === 0) return null; // totalmente transparente: seguimos buscando
+            function h(n) { var s = n.toString(16); return s.length === 1 ? '0' + s : s; }
+            return '#' + h(r) + h(g) + h(b);
+          }
+
+          function opaqueBackgroundAt(x, y) {
+            var el = document.elementFromPoint(x, y);
+            var guard = 0;
+            while (el && guard < 40) {
+              var hex = toHex(window.getComputedStyle(el).backgroundColor);
+              if (hex) return hex;
+              el = el.parentElement;
+              guard++;
+            }
+            var bodyHex = toHex(window.getComputedStyle(document.body).backgroundColor);
+            if (bodyHex) return bodyHex;
+            return toHex(window.getComputedStyle(document.documentElement).backgroundColor) || '#111239';
+          }
+
+          var lastTop = null, lastBottom = null;
+          function detectar() {
+            try {
+              var w = window.innerWidth;
+              var h = window.innerHeight;
+              var topColor = opaqueBackgroundAt(Math.floor(w / 2), 1);
+              var bottomColor = opaqueBackgroundAt(Math.floor(w / 2), h - 1);
+              if (topColor !== lastTop || bottomColor !== lastBottom) {
+                lastTop = topColor;
+                lastBottom = bottomColor;
+                if (window.AndroidColorBridge && window.AndroidColorBridge.onColorsDetected) {
+                  window.AndroidColorBridge.onColorsDetected(topColor, bottomColor);
+                }
+              }
+            } catch (e) {}
+          }
+
+          var pending = false;
+          function programarDeteccion() {
+            if (pending) return;
+            pending = true;
+            requestAnimationFrame(function() {
+              pending = false;
+              detectar();
+            });
+          }
+
+          detectar();
+          window.addEventListener('scroll', programarDeteccion, { passive: true });
+          window.addEventListener('resize', programarDeteccion);
+
+          var observer = new MutationObserver(programarDeteccion);
+          observer.observe(document.documentElement, {
+            attributes: true,
+            attributeFilter: ['style', 'class'],
+            subtree: true,
+            childList: true
+          });
+
+          // Red de seguridad: cubre transiciones/gradientes/canvas que cambian
+          // de color sin disparar mutaciones de DOM ni scroll.
+          setInterval(detectar, 1000);
+        })();
+    """.trimIndent()
+
+    // Puente expuesto a la web como "AndroidColorBridge". Solo recibe dos
