+    // Transición suave en vez de un cambio brusco de color, para que no se
+    // sienta como un parpadeo al pasar de una pantalla a otra de la web.
+    private fun animarColorDeVista(
+        view: View,
+        desde: Int,
+        hasta: Int,
+        animadorPrevio: ValueAnimator?
+    ): ValueAnimator {
+        animadorPrevio?.cancel()
+        return ValueAnimator.ofObject(ArgbEvaluator(), desde, hasta).apply {
+            duration = 300
+            addUpdateListener { anim -> view.setBackgroundColor(anim.animatedValue as Int) }
+            start()
+        }
+    }
+
+    // Si el color de fondo detectado es claro, los iconos del sistema
+    // (reloj, batería, navegación) pasan a modo oscuro para seguir siendo
+    // legibles, y viceversa.
+    private fun ajustarIconosSistemaSegunColor(color: Int, esBarraDeEstado: Boolean) {
+        val esClaro = ColorUtils.calculateLuminance(color) > 0.5
+        val controller = WindowCompat.getInsetsController(window, window.decorView)
+        if (esBarraDeEstado) {
+            controller.isAppearanceLightStatusBars = esClaro
+        } else {
+            controller.isAppearanceLightNavigationBars = esClaro
+        }
+    }
