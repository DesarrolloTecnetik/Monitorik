diff --git a/app/src/main/res/layout/dialog_ubicacion_background.xml b/app/src/main/res/layout/dialog_ubicacion_background.xml
new file mode 100644
index 0000000..bbc6a64
--- /dev/null
+++ b/app/src/main/res/layout/dialog_ubicacion_background.xml
@@ -0,0 +1,79 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Diálogo de "Ubicación en segundo plano" con el mismo lenguaje visual que
+    el modal nativo de permisos de Android (icono en cuadrado redondeado,
+    título en negrita, mensaje centrado y botones tipo pill apilados en vez
+    del AlertDialog gris por defecto).
+-->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:background="@drawable/bg_dialog_permiso"
+    android:paddingHorizontal="24dp"
+    android:paddingTop="28dp"
+    android:paddingBottom="20dp"
+    android:gravity="center_horizontal">
+
+    <FrameLayout
+        android:layout_width="56dp"
+        android:layout_height="56dp"
+        android:background="@drawable/bg_icon_dialogo_permiso"
+        android:layout_marginBottom="20dp">
+
+        <ImageView
+            android:layout_width="28dp"
+            android:layout_height="28dp"
+            android:layout_gravity="center"
+            android:src="@drawable/ic_ubicacion_dialogo"
+            android:contentDescription="@null" />
+    </FrameLayout>
+
+    <TextView
+        android:id="@+id/tituloDialogoUbicacion"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:text="Ubicación en segundo plano"
+        android:textColor="#FFFFFF"
+        android:textSize="20sp"
+        android:textStyle="bold"
+        android:gravity="center"
+        android:fontFamily="sans-serif-medium"
+        android:layout_marginBottom="12dp" />
+
+    <TextView
+        android:id="@+id/mensajeDialogoUbicacion"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:text="Monitorik necesita acceder a tu ubicación incluso cuando la app está minimizada o la pantalla apagada, para que tu empresa pueda dar seguimiento a tu jornada laboral. Puedes desactivar esto en cualquier momento desde Ajustes del sistema."
+        android:textColor="#C7C7CC"
+        android:textSize="14sp"
+        android:gravity="center"
+        android:lineSpacingExtra="2dp"
+        android:layout_marginBottom="24dp" />
+
+    <Button
+        android:id="@+id/btnContinuarUbicacion"
+        android:layout_width="match_parent"
+        android:layout_height="52dp"
+        android:text="Continuar"
+        android:textAllCaps="false"
+        android:textColor="#FFFFFF"
+        android:textSize="16sp"
+        android:textStyle="bold"
+        android:background="@drawable/bg_boton_dialogo_primario"
+        android:stateListAnimator="@null"
+        android:layout_marginBottom="10dp" />
+
+    <Button
+        android:id="@+id/btnAhoraNoUbicacion"
+        android:layout_width="match_parent"
+        android:layout_height="52dp"
+        android:text="Ahora no"
+        android:textAllCaps="false"
+        android:textColor="#FFFFFF"
+        android:textSize="16sp"
+        android:background="@drawable/bg_boton_dialogo_secundario"
+        android:stateListAnimator="@null" />
+
+</LinearLayout>
